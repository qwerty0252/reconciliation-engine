# Application
APP_ENV=development
SECRET_KEY=changeme-super-secret-key-in-production
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bankops_reconciliation
POSTGRES_USER=bankops
POSTGRES_PASSWORD=bankops_secret
DATABASE_URL=postgresql+asyncpg://bankops:bankops_secret@localhost:5432/bankops_reconciliation

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=bankops
RABBITMQ_PASSWORD=bankops_secret
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://bankops:bankops_secret@localhost:5672/

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Alert Channels
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@bankops.io
SMTP_PASSWORD=smtp_secret
ALERT_EMAIL_FROM=alerts@bankops.io
ALERT_EMAIL_TO=ops@bankops.io

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE/ME

# Reconciliation
RECON_SCHEDULE_MINUTES=5
RECON_SETTLEMENT_DELAY_HOURS=24
RECON_REVERSAL_DELAY_HOURS=48
RECON_DUPLICATE_WINDOW_SECONDS=86400

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
